/*
 * Loon 插件：YouTube 字幕翻译
 *
 * 用你自己的翻译 API（OpenAI 兼容 / DeepSeek / Moonshot / DeepL / Google / 自定义）
 * 把 YouTube 字幕在代理层直接换成目标语言，YouTube App 无感。
 *
 * 安装：Loon「插件 → 添加 → 从 URL 安装」填本文件 raw 链接，装完点插件进详情页
 *      就能看到下面的参数表单，直接填 API Key 即可。
 * 本地开发：把三条 script(...) 里的 raw 链接换成本机相对路径 scripts/yt-subtitle-translate.js。
 *
 * 参数语法要求 Loon 3.5.1 (983) 起的新版 Script 语法；老版本请见 README 的兼容写法。
 * 详细说明见 README.md
 */

#!name=YouTube 字幕翻译
#!desc=用你自己的翻译 API 把 YouTube 字幕换成目标语言（OpenAI 兼容 / DeepSeek / DeepL / Google / 自定义）
#!system=iOS
#!author=YG
#!homepage=https://github.com/scutlzc/loon-youtube-subtitle-translate
#!date=2026-11-22
#!tag=YouTube,字幕,翻译
#!loon_version=3.5.1(983)
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[Argument]
# 语法：参数名 = 控件类型,默认值,type=值类型,tag=界面标题,desc=说明（说明里不要写英文逗号）
provider = select,"openai","deepl","google","custom",type=string,tag=翻译后端,desc=openai 兼容 DeepSeek Moonshot 通义 智谱 Ollama 和各类中转；deepl 需官方 key；google 免 key 但限速；custom 走自定义模板
api_base_url = input,"https://api.openai.com/v1/chat/completions",type=string,tag=接口地址,desc=openai 填到 chat/completions 整条地址；deepl 填 https://api-free.deepl.com/v2/translate；google 与 custom 见 README
api_key = input,"",type=string,tag=API Key,desc=翻译服务的密钥；google 后端可留空
api_model = input,"gpt-4o-mini",type=string,tag=模型名,desc=openai 与 custom 后端使用；deepl 与 google 忽略此项
target_lang = select,"zh-CN","zh-TW","ja","en","ko",type=string,tag=目标语言,desc=字幕要翻成的语言
source_lang = input,"auto",type=string,tag=源语言,desc=auto 表示自动判断
cues_per_request = input,40,type=number,tag=每次条数,desc=一次请求最多翻译多少条字幕；越小越稳但请求更多
chars_per_request = input,2500,type=number,tag=每次字符,desc=一次请求的字符预算；到量就切下一片
max_cues = input,500,type=number,tag=单次上限,desc=超过这个条数的字幕保留原文不翻译
timeout_ms = input,95000,type=number,tag=总预算毫秒,desc=整体翻译时限；超时先返回已经翻好的部分
force_json3 = switch,true,tag=强制 json3,desc=改写 player 响应里的字幕地址保证格式可解析；建议开启
cache = switch,true,tag=译文缓存,desc=同一视频重看不重复调用 API 省钱
debug = switch,false,tag=调试日志,desc=开启后记录耗时与请求结果便于排错
system_prompt = input,"",type=string,tag=自定义提示词,desc=留空用内置字幕翻译提示词；openai 与 custom 后端生效
custom_body = input,"",type=string,tag=自定义请求体,desc=仅 custom 后端使用；留空用内置模板 占位符写法见 README
custom_response_path = input,"",type=string,tag=响应取值路径,desc=仅 custom 后端使用；例如 data.translations 留空默认 translations
custom_item_path = input,"",type=string,tag=条目取值路径,desc=仅 custom 后端使用；响应里每条译文是对象时填它的文本字段名

[Script]
# 1) timedtext：字幕文本本体，支持 json3 / srv3 / vtt / ttml
response if ${url} ~= /^https?:\/\/(www|m|music)\.youtube\.com\/api\/timedtext/i then script("https://raw.githubusercontent.com/scutlzc/loon-youtube-subtitle-translate/main/scripts/yt-subtitle-translate.js", {${provider}, ${api_base_url}, ${api_key}, ${api_model}, ${target_lang}, ${source_lang}, ${cues_per_request}, ${chars_per_request}, ${max_cues}, ${timeout_ms}, ${force_json3}, ${cache}, ${debug}, ${system_prompt}, ${custom_body}, ${custom_response_path}, ${custom_item_path}}) with tag="YT字幕·翻译字幕", timeout=180, requires_body=true

# 2) get_transcript：新版转录面板接口（JSON）
response if ${url} ~= /^https?:\/\/((www|m)\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/get_transcript/i then script("https://raw.githubusercontent.com/scutlzc/loon-youtube-subtitle-translate/main/scripts/yt-subtitle-translate.js", {${provider}, ${api_base_url}, ${api_key}, ${api_model}, ${target_lang}, ${source_lang}, ${cues_per_request}, ${chars_per_request}, ${max_cues}, ${timeout_ms}, ${force_json3}, ${cache}, ${debug}, ${system_prompt}, ${custom_body}, ${custom_response_path}, ${custom_item_path}}) with tag="YT字幕·转录面板", timeout=180, requires_body=true

# 3) player：把 captionTracks[].baseUrl 的 fmt 统一改成 json3，保证字幕可解析
response if ${url} ~= /^https?:\/\/((www|m)\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/player/i then script("https://raw.githubusercontent.com/scutlzc/loon-youtube-subtitle-translate/main/scripts/yt-subtitle-translate.js", {${provider}, ${api_base_url}, ${api_key}, ${api_model}, ${target_lang}, ${source_lang}, ${cues_per_request}, ${chars_per_request}, ${max_cues}, ${timeout_ms}, ${force_json3}, ${cache}, ${debug}, ${system_prompt}, ${custom_body}, ${custom_response_path}, ${custom_item_path}}) with tag="YT字幕·强制json3", timeout=180, requires_body=true

[MITM]
hostname = www.youtube.com, m.youtube.com, youtubei.googleapis.com, music.youtube.com
