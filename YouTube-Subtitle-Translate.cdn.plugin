/*
 * Loon 插件：YouTube 字幕翻译
 *
 * 用你自己的翻译 API（OpenAI 兼容 / DeepSeek / Moonshot / DeepL / Google / 自定义）
 * 把 YouTube 字幕在代理层直接换成目标语言，YouTube App 无感。
 *
 * 安装：Loon「插件 → 添加 → 从 URL 安装」填本文件 raw 链接，装完点插件进详情页
 *      就能看到下面的参数表单，直接填 API Key 即可。
 * 本地开发：把三条 script(...) 里的 raw 链接换成本机相对路径 scripts/yt-subtitle-translate.js。
 *
 * 参数语法要求 Loon 3.5.1 (983) 起的新版 Script 语法；老版本请见 README 的兼容写法。
 * 详细说明见 README.md
 */

#!name=YouTube 字幕翻译 (CDN)
#!desc=脚本走 jsDelivr CDN，GitHub raw 不可达时用这个；用你自己的翻译 API 把 YouTube 字幕换成目标语言（OpenAI 兼容 / DeepSeek / DeepL / Google / 自定义）
#!system=iOS
#!author=YG
#!homepage=https://github.com/scutlzc/loon-youtube-subtitle-translate
#!date=2026-11-22
#!tag=YouTube,字幕,翻译
#!loon_version=3.5.1(983)
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[Argument]
# 语法：参数名 = 控件类型,默认值,type=值类型,tag=界面标题,desc=说明（说明里不要写英文逗号）
provider = select,"openai","deepl","gemini","google","custom",type=string,tag=翻译后端,desc=openai 兼容 DeepSeek Moonshot 通义 智谱 Ollama 和各类中转；deepl 需官方 key；gemini 走 Google 原生 Interactions 支持 AQ. 开头的 key；google 是免 key 免费接口 不读下面三行；custom 走自定义模板
api_base_url = input,"https://api.deepseek.com/chat/completions",type=string,tag=接口地址,desc=默认 DeepSeek 直连；gemini 留空即自动用 Interactions API；openai 官方填到 chat/completions 整条地址；deepl 填 https://api-free.deepl.com/v2/translate；google 与 custom 见 README
api_key = input,"",type=string,tag=API Key,desc=翻译服务的密钥；google 后端可留空
api_model = input,"deepseek-flash",type=string,tag=模型名,desc=openai 与 custom 用 默认 deepseek-flash；gemini 填 gemini-3.7-flash 或 gemini-2.5-flash；deepl 与 google 忽略此项
target_lang = select,"zh-CN","zh-TW","ja","en","ko",type=string,tag=目标语言,desc=字幕要翻成的语言
subtitle_mode = select,"menu","google","llm",type=string,tag=字幕方式,desc=menu 推荐 解锁播放器自动翻译全语言 挑一次就记住 最稳；google 自动给字幕地址加 tlang 秒出但部分视频会被 YouTube 拒；llm 用上面配的模型逐条翻 质量最好但慢
bilingual = switch,false,tag=双语字幕,desc=开启后每条字幕显示两行 上一行原文 下一行译文
source_lang = input,"auto",type=string,tag=源语言,desc=auto 表示自动判断
cues_per_request = input,"50",type=number,tag=每次条数,desc=一次请求最多翻译多少条字幕；字幕请求是客户端阻塞等待的 太小会拖慢首屏
chars_per_request = input,"2500",type=number,tag=每次字符,desc=一次请求的字符预算；到量就切下一片
max_cues = input,500,type=number,tag=单次上限,desc=超过这个条数的字幕保留原文不翻译
timeout_ms = input,20000,type=number,tag=总预算毫秒,desc=整体翻译时限；超时先返回已翻部分加原文 别让客户端干等
concurrency = input,"4",type=number,tag=并发请求,desc=同时发几个翻译请求；3 比较稳 越高首屏越快也越容易撞限速
soft_deadline_ms = input,9000,type=number,tag=软截止毫秒,desc=到点就先把已翻好的交回去 剩下的保留原文 防止客户端报字幕加载失败
retry_times = input,2,type=number,tag=失败重试次数,desc=遇到 429 503 high demand 这类临时错误时重试几次；gemini 后端重试会自动换到 fallback 模型 更稳
fallback_model = input,"gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.8-flash",type=string,tag=备用模型,desc=模型名报 404 或过载时依次换的备用模型 逗号分隔 留空用内置 gemini 链
force_json3 = switch,true,tag=强制 json3,desc=改写 player 响应里的字幕地址保证格式可解析；建议开启
cache = switch,true,tag=译文缓存,desc=同一视频重看不重复调用 API 省钱
prefetch = switch,true,tag=预取预热,desc=在 player 阶段先把字幕翻译好写进缓存；打开后开启字幕几乎秒出
debug = switch,false,tag=调试日志,desc=开启后记录耗时与请求结果便于排错
system_prompt = input,"",type=string,tag=自定义提示词,desc=留空用内置字幕翻译提示词；openai 与 custom 后端生效
custom_body = input,"",type=string,tag=自定义请求体,desc=仅 custom 后端使用；留空用内置模板 占位符写法见 README
custom_response_path = input,"",type=string,tag=响应取值路径,desc=仅 custom 后端使用；例如 data.translations 留空默认 translations
custom_item_path = input,"",type=string,tag=条目取值路径,desc=仅 custom 后端使用；响应里每条译文是对象时填它的文本字段名

about = input,"v2026.11.22.15 · 当前版本",type=string,tag=关于/版本,desc=这里就是插件版本号 通知里也会带 方便确认有没有更新成功

[Script]
# 1) timedtext：字幕文本本体，支持 json3 / srv3 / vtt / ttml
response if ${url} ~= /^https?:\/\/(www|m|music)\.youtube\.com\/api\/timedtext/i then script("https://cdn.jsdelivr.net/gh/scutlzc/loon-youtube-subtitle-translate@main/scripts/yt-subtitle-translate.js", {${provider}, ${api_base_url}, ${api_key}, ${api_model}, ${target_lang}, ${subtitle_mode}, ${bilingual}, ${source_lang}, ${cues_per_request}, ${chars_per_request}, ${max_cues}, ${timeout_ms}, ${soft_deadline_ms}, ${concurrency}, ${retry_times}, ${fallback_model}, ${force_json3}, ${cache}, ${prefetch}, ${debug}, ${system_prompt}, ${custom_body}, ${custom_response_path}, ${custom_item_path}}) with tag="YT字幕·翻译字幕", timeout=180, requires_body=true

# 2) get_transcript：新版转录面板接口（JSON）
response if ${url} ~= /^https?:\/\/((www|m)\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/get_transcript/i then script("https://cdn.jsdelivr.net/gh/scutlzc/loon-youtube-subtitle-translate@main/scripts/yt-subtitle-translate.js", {${provider}, ${api_base_url}, ${api_key}, ${api_model}, ${target_lang}, ${subtitle_mode}, ${bilingual}, ${source_lang}, ${cues_per_request}, ${chars_per_request}, ${max_cues}, ${timeout_ms}, ${soft_deadline_ms}, ${concurrency}, ${retry_times}, ${fallback_model}, ${force_json3}, ${cache}, ${prefetch}, ${debug}, ${system_prompt}, ${custom_body}, ${custom_response_path}, ${custom_item_path}}) with tag="YT字幕·转录面板", timeout=180, requires_body=true

# 3) player：把 captionTracks[].baseUrl 的 fmt 统一改成 json3，保证字幕可解析
response if ${url} ~= /^https?:\/\/((www|m)\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/player/i then script("https://cdn.jsdelivr.net/gh/scutlzc/loon-youtube-subtitle-translate@main/scripts/yt-subtitle-translate.js", {${provider}, ${api_base_url}, ${api_key}, ${api_model}, ${target_lang}, ${subtitle_mode}, ${bilingual}, ${source_lang}, ${cues_per_request}, ${chars_per_request}, ${max_cues}, ${timeout_ms}, ${soft_deadline_ms}, ${concurrency}, ${retry_times}, ${fallback_model}, ${force_json3}, ${cache}, ${prefetch}, ${debug}, ${system_prompt}, ${custom_body}, ${custom_response_path}, ${custom_item_path}}) with tag="YT字幕·强制json3", timeout=180, requires_body=true

[MITM]
hostname = www.youtube.com, m.youtube.com, youtubei.googleapis.com, music.youtube.com
